{
  "name": "oscantores",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@loadable/component": "^5.16.7",
    "@reduxjs/toolkit": "^2.11.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "emoji-picker-react": "^4.16.1",
    "enforce-unique": "^1.3.0",
    "lodash": "^4.17.21",
    "millify": "^6.1.0",
    "msw": "^2.12.4",
    "react": "^19.2.1",
    "react-app-rewired": "^2.2.1",
    "react-contenteditable": "^3.3.7",
    "react-dom": "^19.2.1",
    "react-icons": "^5.5.0",
    "react-loading-skeleton": "^3.5.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.11.0",
    "react-scripts": "^5.0.1",
    "sass": "^1.94.2",
    "socket.io-client": "^4.8.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-app-rewired start",
    "lint:check": "eslint 'src/**/*.js'",
    "lint:fix": "eslint 'src/**/*.js' --fix",
    "prettier:check": "prettier --check 'src/**/*.{js,jsx,json}'",
    "prettier:fix": "prettier --write 'src/**/*.{js,jsx,json}'",
    "build": "CI=false react-app-rewired build",
    "test": "react-app-rewired test --coverage --forceExit --detectOpenHandles --watchAll=false",
    "seeds:dev": "npx ts-node src/seeds.ts"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@faker-js/faker": "^6.3.1",
    "@types/axios": "^0.9.36",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^16.5.0",
    "jest-canvas-mock": "^2.5.2",
    "prettier": "^3.7.4",
    "react-app-alias": "^2.2.2"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/test/*.js?(x)",
      "!**/node_modules/**"
    ],
    "coverageReporters": [
      "text-summary",
      "lcov"
    ],
    "moduleNameMapper": {
      "@components/(.*)": [
        "<rootDir>/src/components/$1"
      ],
      "@services/(.*)": [
        "<rootDir>/src/services/$1"
      ],
      "@hooks/(.*)": [
        "<rootDir>/src/hooks/$1"
      ],
      "@mocks/(.*)": [
        "<rootDir>/src/mocks/$1"
      ],
      "@pages/(.*)": [
        "<rootDir>/src/pages/$1"
      ],
      "@redux/(.*)": [
        "<rootDir>/src/redux-toolkit/$1"
      ],
      "@assets/(.*)": [
        "<rootDir>/src/assets/$1"
      ],
      "@colors/(.*)": [
        "<rootDir>/src/colors/$1"
      ],
      "@root/(.*)": [
        "<rootDir>/src/$1"
      ]
    }
  }
}
